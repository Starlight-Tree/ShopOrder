{
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh)",
      "Bash(scripts/verify.sh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backups/**)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(./.dev.vars)",
      "Read(./.git/sensitive-terms)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.infisical/**)",
      "Read(~/.ssh/**)",
      "Bash(git commit *--no-verify*)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(*npm ci*)",
      "Edit(**/CLAUDE.md)",
      "mcp__github__actions_run_trigger",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_file_upload"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-cloud-cli.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-write.py"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-deploy-cli.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-rules.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
